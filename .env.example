# Copy this file to .env.local for local dev, and set the same keys
# in your Vercel project's Environment Variables for production.
# NEVER commit .env.local or your real keys to git.

# Your OpenAI API key (used for chat completions + embeddings)
OPENAI_API_KEY=sk-...

# The password users must enter to access the app.
# Choose your own value here — do NOT hardcode it in source files.
UPSC_ACCESS_PASSWORD=your-password-here
